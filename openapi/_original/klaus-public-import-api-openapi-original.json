          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "ticketExternalId",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "tags": [
          "PubImportApi"
        ]
      }
    },
